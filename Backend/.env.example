APP_NAME=SENTINAL
ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./sentinal.db
REDIS_URL=redis://localhost:6379/0
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BASELINE_DAYS=15
PASS_THRESHOLD=80
CHALLENGE_THRESHOLD=50
BASELINE_UPDATE_THRESHOLD=80
ML_MODEL_PATH=app/ml/models/network_forecast.pkl
ML_FORECAST_WEIGHT=0.40
SEQUENCE_ANALYSIS_WEIGHT=0.25
RELATIONSHIP_ANALYSIS_WEIGHT=0.20
INTEGRITY_ANALYSIS_WEIGHT=0.15
MAX_PREDICTED_TARGETS=3
DEFAULT_ANALYSIS_WINDOW_MINUTES=15
SHORT_WINDOW_MINUTES=5
MEDIUM_WINDOW_MINUTES=30
LONG_WINDOW_MINUTES=60
HIGH_CONFIDENCE_THRESHOLD=0.80
MEDIUM_CONFIDENCE_THRESHOLD=0.60
LOW_CONFIDENCE_THRESHOLD=0.40
MODEL_VERSION=1.0.0
PREPROCESSING_VERSION=1.0.0
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
